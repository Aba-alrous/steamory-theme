{#
| Variable            | Type   | Description                                          |
|---------------------|--------|------------------------------------------------------|
| title               | string | Optional section heading                             |
| rows[]              | array  | The cover art                                        |
| rows[].image        | string | Cover artwork                                        |
| rows[].second_row   | bool   | Put this cover on the second strip instead           |
| rows_count          | string | 1 or 2 strips                                        |
| direction_1         | string | rtl | ltr — travel direction of the first strip     |
| direction_2         | string | rtl | ltr — travel direction of the second strip    |
| speed               | string | slow | normal | fast                                  |
| position            | int    | Sorting number, starts at zero                       |
#}
{# twilight.json fields arrive on `component`. #}
{% set title = component.title %}
{% set rows = component.rows %}
{% set rows_count = component.rows_count %}
{% set direction_1 = component.direction_1|default('rtl') %}
{% set direction_2 = component.direction_2|default('ltr') %}
{% set speed = component.speed|default('normal') %}

{% set all_covers = rows|default([])|filter((item) => item.image) %}

{% if all_covers is not empty %}

{% set two_strips = rows_count != '1' %}

{# Seconds each tile should take to cross the strip. The track length changes
   with the number of covers, so a fixed duration made a long strip crawl —
   pacing per tile is what keeps "fast" actually fast at any count. #}
{% set pace = { 'slow': 2.4, 'normal': 1.3, 'fast': 0.55 } %}
{% set per_tile = pace[speed]|default(1.3) %}

<section data-testid="store-home-steamory-marquee"
         class="s-block st-marquee"
         id="steamory-marquee-{{ position }}">

  {% if title %}
    <div class="container">
      <div class="s-block__title"><div class="right-side"><h2>{{ title }}</h2></div></div>
    </div>
  {% endif %}

  {% for strip in (two_strips ? [1, 2] : [1]) %}

    {% if two_strips %}
      {# Covers are assigned per image from the panel; anything left unassigned
         falls to the first strip. #}
      {% set strip_covers = all_covers|filter((item) =>
        (strip == 2) == (item.second_row ? true : false)) %}
    {% else %}
      {% set strip_covers = all_covers %}
    {% endif %}

    {% if strip_covers is not empty %}
      {# With only a few covers the strip would be mostly empty space, so the
         set is repeated enough times to fill it before the loop is built. #}
      {% set repeat = (12 / strip_covers|length)|round(0, 'ceil') %}
      {% set repeat = repeat < 1 ? 1 : repeat %}
      {% set set_size = strip_covers|length * repeat %}
      {% set direction = strip == 2 ? direction_2 : direction_1 %}

      <div class="st-marquee__row st-marquee__row--{{ strip }} {{ direction == 'ltr' ? 'st-marquee__row--reverse' : '' }}"
           aria-hidden="true"
           style="--st-marquee-duration: {{ (set_size * per_tile)|round(1) }}s;">
        {# The set is rendered twice on top of the repeats: the track shifts by
           50%, so the second half is what closes the loop with no jump. #}
        <div class="st-marquee__track">
          {% for pass in 1..2 %}
            {% for copy in 1..repeat %}
              {% for item in strip_covers %}
                <div class="st-marquee__tile">
                  <img src="{{ item.image }}" alt="" loading="lazy" decoding="async">
                </div>
              {% endfor %}
            {% endfor %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

  {% endfor %}
</section>
{% endif %}
