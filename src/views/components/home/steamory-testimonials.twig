{#
| Variable         | Type   | Description                                             |
|------------------|--------|---------------------------------------------------------|
| title            | string | Section heading                                         |
| summary_value    | string | Headline rating, e.g. 4.9                               |
| summary_label    | string | What the rating counts, e.g. 98 تقييماً                 |
| items[]          | array  | The reviews                                             |
| items[].name     | string | Reviewer name                                           |
| items[].stars    | int    | 1 to 5                                                  |
| items[].text     | string | Review body                                             |
| position         | int    | Sorting number, starts at zero                          |
#}
{# twilight.json fields arrive on `component`. #}
{% set title = component.title %}
{% set summary_value = component.summary_value %}
{% set summary_label = component.summary_label %}
{% set items = component.items %}
{% set display = component.display|default('auto') %}
{% set columns = component.columns|default('3') %}

{% set review_items = items|default([])|filter((item) => item.text or item.name) %}
{% if review_items is not empty %}
<section data-testid="store-home-steamory-testimonials"
         class="s-block st-section st-testi st-testi--{{ display }} st-testi--cols-{{ columns }}"
         id="steamory-testimonials-{{ position }}">

  <div class="container">
    <div class="st-section__head">
      {% if title %}<h2 class="st-section__title">{{ title }}</h2>{% endif %}
      {% if summary_value %}
        <div class="st-testi__summary">
          <strong>{{ summary_value }}</strong>
          {% if summary_label %}<span>{{ summary_label }}</span>{% endif %}
        </div>
      {% endif %}
    </div>
  </div>

  {# Three layouts share one card. `auto` is a full-bleed self-scrolling rail;
     `drag` is the same rail but scrolled by hand; `grid` drops the rail and
     lays the cards out in a static block. Only `auto` needs the second pass
     of duplicated cards that closes the animation loop. #}
  {% set is_grid = display == 'grid' %}
  {% set passes = display == 'auto' ? 2 : 1 %}

  <div class="{{ is_grid ? 'container st-testi__grid' : 'st-testi__rail' }}"
       {% if display == 'drag' %}data-st-drag{% endif %}>
    <div class="{{ is_grid ? 'contents' : 'st-testi__track' }}">
      {% for pass in 1..passes %}
        {% for item in review_items %}
          <figure class="st-testi__card" {{ pass == 2 ? 'aria-hidden="true"' : '' }}>
            <div class="st-testi__stars" aria-label="{{ item.stars|default(5) }} من 5">
              {% for star in 1..(item.stars|default(5)) %}
                <i class="sicon-star2" aria-hidden="true"></i>
              {% endfor %}
            </div>
            <blockquote class="st-testi__text">{{ item.text }}</blockquote>
            <figcaption class="st-testi__name">{{ item.name }}</figcaption>
          </figure>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
